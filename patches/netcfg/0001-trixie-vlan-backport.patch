diff --git a/test/test_netcfg_parse_vlan_id.c b/test/test_netcfg_parse_vlan_id.c
new file mode 100644
index 0000000..93a5840
--- /dev/null
+++ b/test/test_netcfg_parse_vlan_id.c
@@ -0,0 +1,47 @@
+#include "srunner.h"
+#include "netcfg.h"
+
+START_TEST(test_netcfg_parse_vlan_id_valid)
+{
+	int vlanid = -1;
+
+	ck_assert(netcfg_parse_vlan_id("1", &vlanid));
+	ck_assert_int_eq(vlanid, 1);
+	ck_assert(netcfg_parse_vlan_id("100", &vlanid));
+	ck_assert_int_eq(vlanid, 100);
+	ck_assert(netcfg_parse_vlan_id("4094", &vlanid));
+	ck_assert_int_eq(vlanid, 4094);
+}
+END_TEST
+
+START_TEST(test_netcfg_parse_vlan_id_reserved)
+{
+	int vlanid = -1;
+
+	ck_assert(!netcfg_parse_vlan_id("0", &vlanid));
+	ck_assert(!netcfg_parse_vlan_id("4095", &vlanid));
+}
+END_TEST
+
+START_TEST(test_netcfg_parse_vlan_id_nonnumeric)
+{
+	int vlanid = -1;
+
+	ck_assert(!netcfg_parse_vlan_id("", &vlanid));
+	ck_assert(!netcfg_parse_vlan_id("vlan100", &vlanid));
+	ck_assert(!netcfg_parse_vlan_id("100vlan", &vlanid));
+}
+END_TEST
+
+Suite *test_netcfg_parse_vlan_id_suite(void)
+{
+	Suite *s = suite_create("netcfg_parse_vlan_id");
+	TCase *tc = tcase_create("netcfg_parse_vlan_id");
+
+	tcase_add_test(tc, test_netcfg_parse_vlan_id_valid);
+	tcase_add_test(tc, test_netcfg_parse_vlan_id_reserved);
+	tcase_add_test(tc, test_netcfg_parse_vlan_id_nonnumeric);
+	suite_add_tcase(s, tc);
+
+	return s;
+}
